{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "little-blossom",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-10-18",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "little-blossom-db",
      "database_id": "2048e023-efac-4f95-84fd-9d954af2ddd8"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "little-blossom-photos"
    }
  ]
}
